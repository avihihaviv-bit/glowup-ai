# ─────────────────────────────────────────────────────────────────────────────
# GLOWUP AI: server-side settings. Put real values in Vercel → Settings →
# Environment Variables (or .env.local for local dev). NEVER commit real keys.
# None of these are sent to the browser (no NEXT_PUBLIC_ prefix).
# With no key at all, the app runs in a clearly-labeled Demo mode.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI providers (set one or more) ──────────────────────────────────────────
# Several keys per provider: comma-separated in *_API_KEYS.
# Backup keys are used when a key fails authentication. On a 429 the router
# moves to the next PROVIDER, because keys of the same account/project usually
# share one quota. Set *_KEYS_SEPARATE_QUOTA=true only if each key really has
# its own quota (separate projects/plans you are allowed to use).
GEMINI_API_KEY=
# GEMINI_API_KEYS=key1,key2
# GEMINI_KEYS_SEPARATE_QUOTA=false
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Order: first configured = primary, the rest are backups ────────────────
# AI_PROVIDERS=gemini,openrouter,groq,anthropic
# (default: anthropic,gemini,openrouter,groq)

# ── Models (optional). Each tier lists candidates in order; ids the account
#    doesn't have are skipped automatically (Gemini/Groq/OpenRouter model lists).
# GEMINI_MODELS_FAST=gemini-flash-lite-latest
# GEMINI_MODELS_BALANCED=gemini-flash-latest,gemini-3.8-flash
# GEMINI_MODELS_DEEP=gemini-pro-latest
# GEMINI_MODELS_VISION=gemini-flash-latest
# GROQ_MODELS_FAST=openai/gpt-oss-20b
# GROQ_MODELS_BALANCED=openai/gpt-oss-120b
# GROQ_MODELS_VISION=        # Groq vision models are preview-only; set what your account lists
# OPENROUTER_MODELS_BALANCED=google/gemini-3.8-flash,openai/gpt-oss-120b
# OPENROUTER_MODELS_VISION=google/gemini-3.8-flash
# ANTHROPIC_MODEL=claude-opus-5-5

# ── Limits & behavior (optional, defaults shown) ───────────────────────────
# AI_MAX_ATTEMPTS=6            # total attempts per request, across all providers
# AI_DEADLINE_MS=100000        # whole-request deadline
# AI_ATTEMPT_TIMEOUT_MS=90000  # per attempt
# AI_MAX_RETRIES=1             # same-provider retries for 5xx/network/timeout
# AI_BACKOFF_BASE_MS=400       # exponential backoff base (with jitter)
# AI_BACKOFF_CAP_MS=6000
# AI_CIRCUIT_THRESHOLD=3       # failed requests before a provider is paused
# AI_CIRCUIT_OPEN_MS=60000     # pause length (doubles on repeat, max 10 min)
# GEMINI_DAILY_REQUEST_LIMIT=  # optional local cap per provider per day
# OPENROUTER_DATA_COLLECTION=deny   # only route to endpoints that don't store prompts
# AI_ROUTER_LOG=on             # structured metadata logs (no prompts, no keys)

# ── Admin screen (/ai-admin) ────────────────────────────────────────────────
# Recommended in production: required code to view stats and run tests.
# AI_ADMIN_TOKEN=

# ── Hair preview image generation (separate from the router) ───────────────
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=
